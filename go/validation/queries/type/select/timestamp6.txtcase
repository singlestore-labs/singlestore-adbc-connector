// part: metadata

[setup]
drop = "test_timestamp"

[tags]
sql-type-name = "DATETIME"

// part: setup_query

CREATE TABLE test_timestamp (
    idx INTEGER,
    res DATETIME(6)
);

INSERT INTO test_timestamp (idx, res) VALUES (1, '2023-05-15 13:45:30' :> DATETIME(6));
INSERT INTO test_timestamp (idx, res) VALUES (2, '2000-01-01 00:00:00' :> DATETIME(6));
INSERT INTO test_timestamp (idx, res) VALUES (3, '1969-07-20 20:17:40' :> DATETIME(6));
INSERT INTO test_timestamp (idx, res) VALUES (4, '9999-12-31 23:59:59' :> DATETIME(6));
INSERT INTO test_timestamp (idx, res) VALUES (5, NULL);
INSERT INTO test_timestamp (idx, res) VALUES (6, '1000-01-01 00:00:00.000000' :> DATETIME(6));
INSERT INTO test_timestamp (idx, res) VALUES (7, '2023-05-15 13:45:30.123456' :> DATETIME(6));

