// part: metadata

[setup]
drop = "test_timestamptz"

[tags]
sql-type-name = "TIMESTAMP"

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INTEGER,
    res TIMESTAMP(6)
);

INSERT INTO test_timestamptz (idx, res) VALUES (1, '2023-05-15 13:45:30' :> DATETIME(6));
INSERT INTO test_timestamptz (idx, res) VALUES (2, '2000-01-01 00:00:00' :> DATETIME(6));
INSERT INTO test_timestamptz (idx, res) VALUES (3, '1970-07-20 20:17:40' :> DATETIME(6));
INSERT INTO test_timestamptz (idx, res) VALUES (4, '2037-12-31 23:59:59' :> DATETIME(6));
INSERT INTO test_timestamptz (idx, res) VALUES (5, NULL);
INSERT INTO test_timestamptz (idx, res) VALUES (6, '1970-01-01 00:00:01.000000' :> DATETIME(6));
INSERT INTO test_timestamptz (idx, res) VALUES (7, '2023-05-15 13:45:30.123456' :> DATETIME(6));

// part: expected

{"res": 1684158330000000}
{"res": 946684800000000}
{"res": 17353060000000}
{"res": 2145916799000000}
{"res": null}
{"res": 1000000}
{"res": 1684158330123456}
